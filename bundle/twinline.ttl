@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<urn:davidian:twinline>
	a lv2:Plugin , lv2:DelayPlugin ;
	doap:name "Davidian Twinline" ;
	doap:license <http://opensource.org/licenses/GPL-3.0> ;
	rdfs:comment "BBD doubler / slapback modelled from a stripboard layout of a classic 1970s BBD double-tracking pedal." ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 0 ;
		lv2:symbol "level" ;
		lv2:name "Level" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 20.0 ;
		units:unit units:db
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 1 ;
		lv2:symbol "blend" ;
		lv2:name "Blend" ;
		lv2:default 0.75 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 2 ;
		lv2:symbol "delay" ;
		lv2:name "Delay" ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:scalePoint [
			rdfs:label "Double (31 ms)" ;
			rdf:value 0
		] , [
			rdfs:label "Slap (90 ms)" ;
			rdf:value 1
		]
	] , [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 3 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 4 ;
		lv2:symbol "out" ;
		lv2:name "Out"
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "on" ;
		lv2:name "Footswitch" ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:toggled
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:designation lv2:enabled ;
		lv2:portProperty lv2:toggled
	] .
